    "id": "900",
    "number": 900,
    "slug": "mlecny-zub",
    "deck": "club",
    "title": "Mléčný zub",
    "season": "Pátá stovka (pracovní)",
    "language": "cs",
    "poemText": [
      "Vypadl jsem",
      "Kluk mě strčil pod polštář",
      "a přišla víla",
      "a nechala mu tam korunu",
      "A já jsem skončil",
      "v krabičce",
      "kterou má máma ve skříni",
      "Jsem mléčný zub",
      "A byl jsem první",
      "Byl jsem ten",
      "kdo se prokousal ven",
      "z dásně",
      "když bylo tomu klukovi",
      "šest měsíců",
      "A on křičel a nespal",
      "a rodiče chodili po bytě",
      "v noci",
      "a nosili ho",
      "a byli zoufalí",
      "Kvůli mně",
      "První zub",
      "to je vždycky drama",
      "A pak jsem sloužil",
      "šest let",
      "kousal jsem rohlíky a jablka",
      "a byl jsem důležitý",
      "A pak jsem se začal viklat",
      "A on se mě bál sáhnout",
      "a viklal mě jazykem",
      "tajně",
      "celé týdny",
      "A pak jsem vypadl",
      "A byla to sláva",
      "a byl v tom kus radosti",
      "a kus strachu",
      "A pod polštář",
      "a víla",
      "a hotovo",
      "A já ležím v krabičce ve skříni",
      "dvacet let",
      "A ten kluk",
      "je dneska muž",
      "a bydlí jinde",
      "a nevolá často",
      "A máma",
      "máma tu krabičku",
      "občas otevře",
      "Nikomu to neřekne",
      "Jenom ji otevře",
      "a dívá se na mě",
      "a je tam nás sedm",
      "sedm malých bílých zubů",
      "a v každém",
      "je celý jeden rok",
      "jeho dětství",
      "Nechte si ty zuby",
      "říkám vám to já",
      "mléčný zub v krabičce",
      "Nechte si je",
      "Je to jediná část dítěte",
      "kterou si smíte",
      "nechat",
      "všechno ostatní",
      "vám",
      "odejde"
    ],
