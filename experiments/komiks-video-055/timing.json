{
 "duration": 86.8401875,
 "verses": [
  {
   "verse": 1,
   "text": "He does not steal money",
   "t": 0.0
  },
  {
   "verse": 2,
   "text": "he steals sleep",
   "t": 4.24
  },
  {
   "verse": 3,
   "text": "At night he slips into bedrooms",
   "t": 9.0
  },
  {
   "verse": 4,
   "text": "making no sound at all",
   "t": 12.22
  },
  {
   "verse": 5,
   "text": "and takes the sleep from people",
   "t": 17.0
  },
  {
   "verse": 6,
   "text": "stuffing it into a great sack",
   "t": 19.94
  },
  {
   "verse": 7,
   "text": "In the morning people wake up weary",
   "t": 24.6
  },
  {
   "verse": 8,
   "text": "with dark shadows under their eyes",
   "t": 28.22
  },
  {
   "verse": 9,
   "text": "they do not know their rest has been stolen",
   "t": 31.66
  },
  {
   "verse": 10,
   "text": "The thief goes home",
   "t": 40.94
  },
  {
   "verse": 11,
   "text": "and gives the stolen sleep",
   "t": 43.64
  },
  {
   "verse": 12,
   "text": "to his little sick daughter",
   "t": 48.46
  },
  {
   "verse": 13,
   "text": "who cannot rest because of the pain",
   "t": 51.54
  },
  {
   "verse": 14,
   "text": "She drifts off at last",
   "t": 57.42
  },
  {
   "verse": 15,
   "text": "with a smile",
   "t": 59.8
  },
  {
   "verse": 16,
   "text": "And the thief watches her",
   "t": 65.46
  },
  {
   "verse": 17,
   "text": "his heart heavy",
   "t": 69.78
  },
  {
   "verse": 18,
   "text": "with being both",
   "t": 72.48
  },
  {
   "verse": 19,
   "text": "a criminal and a savior",
   "t": 75.7
  }
 ]
}