{
 "duration": 157.0001875,
 "verses": [
  {
   "verse": 1,
   "text": "Every morning at seven",
   "t": 0.0
  },
  {
   "verse": 2,
   "text": "on the market square",
   "t": 4.64
  },
  {
   "verse": 3,
   "text": "an old man in a grey coat",
   "t": 8.28
  },
  {
   "verse": 4,
   "text": "crumbled bread for the pigeons",
   "t": 13.48
  },
  {
   "verse": 5,
   "text": "and the pigeons knew him",
   "t": 17.08
  },
  {
   "verse": 6,
   "text": "the way one knows church bells",
   "t": 22.02
  },
  {
   "verse": 7,
   "text": "Then came the sign",
   "t": 26.32
  },
  {
   "verse": 8,
   "text": "FEEDING PIGEONS FORBIDDEN",
   "t": 30.54
  },
  {
   "verse": 9,
   "text": "fine one thousand crowns",
   "t": 35.94
  },
  {
   "verse": 10,
   "text": "signature illegible",
   "t": 40.56
  },
  {
   "verse": 11,
   "text": "Next morning at seven",
   "t": 44.48
  },
  {
   "verse": 12,
   "text": "the old man came",
   "t": 49.74
  },
  {
   "verse": 13,
   "text": "sat down on the bench",
   "t": 53.84
  },
  {
   "verse": 14,
   "text": "with empty hands",
   "t": 57.06
  },
  {
   "verse": 15,
   "text": "entirely empty",
   "t": 62.06
  },
  {
   "verse": 16,
   "text": "and the pigeons came all the same",
   "t": 65.66
  },
  {
   "verse": 17,
   "text": "landed on his shoulders",
   "t": 71.66
  },
  {
   "verse": 18,
   "text": "on his hat",
   "t": 74.72
  },
  {
   "verse": 19,
   "text": "on his knees",
   "t": 75.9
  },
  {
   "verse": 20,
   "text": "The clerk who had signed the sign",
   "t": 77.96
  },
  {
   "verse": 21,
   "text": "watched from the town hall window",
   "t": 82.2
  },
  {
   "verse": 22,
   "text": "on the third day he came down",
   "t": 85.7
  },
  {
   "verse": 23,
   "text": "What are you feeding them? he asked sternly",
   "t": 90.72
  },
  {
   "verse": 24,
   "text": "Nothing, said the man",
   "t": 95.86
  },
  {
   "verse": 25,
   "text": "Then why do they come?",
   "t": 98.86
  },
  {
   "verse": 26,
   "text": "And the old man smiled",
   "t": 124.78
  },
  {
   "verse": 27,
   "text": "The bread, that was for you",
   "t": 127.9
  },
  {
   "verse": 28,
   "text": "so you'd have something to forbid",
   "t": 132.08
  },
  {
   "verse": 29,
   "text": "They never came here for bread",
   "t": 138.36
  },
  {
   "verse": 30,
   "text": "they came here for me",
   "t": 143.04
  },
  {
   "verse": 31,
   "text": "and against that",
   "t": 147.5
  },
  {
   "verse": 32,
   "text": "you have no paragraph yet",
   "t": 149.86
  }
 ]
}